{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onevillage:oregon:walang-intent:0.1.0",
  "title": "WALang intent seed 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent_id", "actor_ref", "observer_ref", "context_revision", "command"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "intent_id": {"$ref": "#/$defs/ref"},
    "actor_ref": {"$ref": "#/$defs/ref"},
    "observer_ref": {"$ref": "#/$defs/ref"},
    "context_revision": {"$ref": "#/$defs/nonnegative"},
    "command": {"$ref": "#/$defs/command"}
  },
  "$defs": {
    "ref": {"type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]{1,120}$"},
    "nonnegative": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "command": {"oneOf": [{"$ref": "#/$defs/action"}, {"$ref": "#/$defs/plan"}]},
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "actor_ref", "operation", "parameters"],
      "properties": {
        "kind": {"const": "ACTION"},
        "actor_ref": {"$ref": "#/$defs/ref"},
        "operation": {"type": "string", "maxLength": 64, "pattern": "^[A-Z][A-Z_]*$"},
        "parameters": {"type": "object", "maxProperties": 24},
        "constraints": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/constraint"}}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "mode", "steps"],
      "properties": {
        "kind": {"const": "PLAN"},
        "mode": {"enum": ["SEQUENTIAL", "PARALLEL", "FALLBACK"]},
        "steps": {"type": "array", "minItems": 2, "maxItems": 32, "items": {"$ref": "#/$defs/command"}}
      }
    },
    "constraint": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "amount_minor", "currency"], "properties": {"kind": {"const": "MAX_SPEND"}, "amount_minor": {"$ref": "#/$defs/nonnegative"}, "currency": {"type": "string", "pattern": "^[A-Z]{3,8}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "time_s"], "properties": {"kind": {"const": "RETURN_BEFORE"}, "time_s": {"$ref": "#/$defs/nonnegative"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "predicate", "observer_ref", "response"], "properties": {"kind": {"const": "ABORT_IF"}, "predicate": {"enum": ["WEATHER_WORSENING", "DANGER_ASSESSED", "TOOL_UNAVAILABLE"]}, "observer_ref": {"$ref": "#/$defs/ref"}, "response": {"enum": ["RETURN", "PAUSE", "CANCEL"]}}}
      ]
    }
  }
}
