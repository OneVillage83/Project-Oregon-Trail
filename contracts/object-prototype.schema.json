{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onevillage:oregon:object-prototype:0.1.0",
  "title": "Physical object prototype seed",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "prototype_id", "display_key", "material_ref", "mass_g", "functional_roles", "states"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "prototype_id": {"$ref": "#/$defs/ref"},
    "display_key": {"type": "string", "minLength": 1, "maxLength": 160},
    "material_ref": {"$ref": "#/$defs/ref"},
    "mass_g": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "volume_ml": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "capacity_ml": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "max_load_g": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "functional_roles": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
    "states": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 80}}
  },
  "$defs": {"ref": {"type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9_.-]*:[A-Za-z0-9_.-]{1,120}$"}}
}
